digraph TimingGraph {
    rankdir=LR;

    node [
         shape=box,
         style=filled,
         fillcolor=lightgray,
         fontname="Helvetica"
    ];

    edge [
         arrowsize=0.8,
         fontname="Helvetica"
    ];

    "A" [
        shape=ellipse,
        label="A\nMax Arrival : 0.20 ns\nMin Arrival : 0.20 ns\nSetup Slack : 5.87 ns\nHold Slack  : 0.00 ns"
    ];
    "B" [
        shape=ellipse,
        label="B\nMax Arrival : 0.25 ns\nMin Arrival : 0.25 ns\nSetup Slack : 6.12 ns\nHold Slack  : 0.00 ns"
    ];
