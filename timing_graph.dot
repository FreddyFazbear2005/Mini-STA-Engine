    ];
    "G11" -> "G12" [
        color="0.000000,1.000000,0.825000",
         penwidth=4.12
    ];
    "G12" -> "FF3_D" [
        color="0.000000,1.000000,0.825000",
         penwidth=4.12
    ];
    "G12" -> "OUT1" [
        color="0.000000,1.000000,0.475000",
         penwidth=2.38
    ];
    "G10" -> "G13" [
        color="0.000000,1.000000,1.000000",
         penwidth=5.00
    ];
    "G13" -> "G14" [
        color="0.000000,1.000000,1.000000",
         penwidth=5.00
    ];
    "G14" -> "FF4_D" [
        color="0.000000,1.000000,1.000000",
         penwidth=5.00
    ];
    "G9" -> "G15" [
        color="0.000000,1.000000,0.650000",
         penwidth=3.25
    ];
    "G15" -> "G16" [
        color="0.000000,1.000000,0.650000",
         penwidth=3.25
    ];
    "G16" -> "FF5_D" [
        color="0.000000,1.000000,0.650000",
         penwidth=3.25
    ];
    "G16" -> "OUT2" [
        color="0.000000,1.000000,0.300000",
         penwidth=1.50
    ];
subgraph cluster_legend {
    label="Legend";
    fontsize=12;
    fillcolor="#F8F8F8";
    style="rounded,filled";
    margin=12;
    fontname="Helvetica";
    node   [style=filled,fillcolor=lightgray];
    PI_PO  [shape=ellipse,      label="Primary I/O"];
    G      [shape=box,      label="Logic Gate"];
    FFQ    [shape=doublecircle,      label="Launch FF"];
    FFD    [shape=octagon,      label="Capture FF"];
    Setup1 [shape=none, width=0, height=0, label=""];
    Setup2 [shape=none, width=0, height=0, label=""];
    Setup1 -> Setup2 [color=red, penwidth=4];
    Hold1 [shape=none, width=0, height=0, label=""];
    Hold2 [shape=none, width=0, height=0, label=""];
    Hold1 -> Hold2 [color=blue, penwidth=4];
    SetupLabel [shape=plaintext, label="Setup Critical Path"];
    HoldLabel  [shape=plaintext, label="Hold Critical Path"];

    Setup2 -> SetupLabel [style=invis];
    Hold2 -> HoldLabel [style=invis];
    PI_PO -> G -> FFQ -> FFD [style=invis];
    { rank=same; PI_PO; G; FFQ; FFD; }
    { rank=same; Setup1; Setup2; SetupLabel; }
    { rank=same; Hold1; Hold2; HoldLabel; }
}
}
